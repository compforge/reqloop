{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [
    "plugins/*/src/**/*.ts",
    "plugins/*/tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
